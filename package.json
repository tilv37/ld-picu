{
  "name": "ld-picu",
  "version": "0.1.0",
  "description": "A minimal personal S3 image uploader",
  "main": "dist/main/main/index.js",
  "author": {
    "name": "LD",
    "email": "ld@localhost"
  },
  "homepage": "https://github.com/tilv37/ld-picu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tilv37/ld-picu.git"
  },
  "bugs": {
    "url": "https://github.com/tilv37/ld-picu/issues"
  },
  "desktopName": "ld-picu",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:main\" \"vite\" \"npm:dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "wait-on tcp:5173 file:dist/main/main/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "vitest run",
    "package": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.ld.picu",
    "productName": "LD PicU",
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon.png",
    "extraResources": [
      {
        "from": "assets/app-icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "assets/tray-icon.png",
        "to": "tray-icon.png"
      }
    ],
    "files": [
      "dist/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "electronLanguages": ["en-US"],
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/linux-icons",
      "category": "Graphics",
      "maintainer": "LD",
      "syncDesktopName": true
    },
    "win": {
      "target": ["nsis"]
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "sharp": "^0.34.1"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.2.4",
    "@img/sharp-libvips-win32-x64": "1.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.1.1",
    "wait-on": "^8.0.2"
  }
}
